@@ -0,0 +1,135 @@
+// Camera tools: technique observations, quality gates and bar-speed estimates on synthetic landmark data.
+// Run with `npm test`. The synthetic lifter is a stick figure moved through known positions, so the expected
+// rep counts, depths and speeds are known exactly.
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { analyseForm, angle, classify, estimateSpeed, gate, KEYS, segmentReps, type Frame, type Key, type Point } from './pose.ts';
+
+const rad = (d: number) => (d * Math.PI) / 180;
+const FPS = 15;
+
+/** One side-on stick figure. p = 0 standing, 1 at the bottom of the rep. */
+function figure(kind: 'squat' | 'hinge' | 'push_up', p: number, vis = 0.9): Record<Key, Point> {
+  const pt = (x: number, y: number): Point => ({ x, y, v: vis });
+  if (kind === 'push_up') {
+    const drop = 0.08 * p;
+    const s = { x: 0.3, y: 0.6 + drop }, a = { x: 0.8, y: 0.75 };
+    const h = { x: 0.52, y: s.y + (a.y - s.y) * 0.44 };
+    const elbowBend = 170 - 90 * p; // elbow angle
+    const e = { x: 0.3 + 0.12 * Math.cos(rad(180 - elbowBend / 2)) * 0.2, y: s.y + 0.08 };
+    const w = { x: 0.3, y: 0.82 };
+    // Place the elbow so the shoulder-elbow-wrist angle follows elbowBend.
+    const upper = 0.12, half = rad(elbowBend / 2);
+    e.x = s.x - upper * Math.sin(Math.PI / 2 - half) * 0.6;
+    e.y = (s.y + w.y) / 2;
+    const lm = { s, e, w, h, k: { x: 0.66, y: 0.71 }, a };
+    return toLm(lm, pt);
+  }
+  const L = 0.2, T = 0.25;
+  const [as, at, ab] = kind === 'squat' ? [35 * p, 95 * p, 40 * p] : [8 * p, 12 * p, 75 * p];
+  const a = { x: 0.5, y: 0.9 };
+  const k = { x: a.x + L * Math.sin(rad(as)), y: a.y - L * Math.cos(rad(as)) };
+  const h = { x: k.x - L * Math.sin(rad(at)), y: k.y - L * Math.cos(rad(at)) };
+  const s = { x: h.x + T * Math.sin(rad(ab)), y: h.y - T * Math.cos(rad(ab)) };
+  return toLm({ s, e: { x: s.x + 0.02, y: s.y + 0.12 }, w: { x: s.x + 0.04, y: s.y + 0.22 }, h, k, a }, pt);
+}
+function toLm(p: Record<'s' | 'e' | 'w' | 'h' | 'k' | 'a', { x: number; y: number }>, pt: (x: number, y: number) => Point): Record<Key, Point> {
+  const out = {} as Record<Key, Point>;
+  for (const k of KEYS) {
+    if (k === 'nose') { out.nose = pt(p.s.x - 0.02, p.s.y - 0.1); continue; }
+    const base = p[k[1] as 's' | 'e' | 'w' | 'h' | 'k' | 'a'];
+    out[k] = pt(base.x + (k[0] === 'r' ? 0.005 : 0), base.y); // right side almost behind the left: side view
+  }
+  return out;
+}
+
+/** 1 s standing still, then `reps` reps of 2 s (1 s down, 1 s up). */
+function video(kind: 'squat' | 'hinge' | 'push_up', reps = 4, opts: { vis?: number; people?: (i: number) => number; luma?: number; depth?: (rep: number) => number } = {}): Frame[] {
+  const frames: Frame[] = [];
+  const total = FPS * (1 + reps * 2);
+  for (let i = 0; i < total; i++) {
+    const t = i / FPS;
+    const rep = Math.floor((t - 1) / 2);
+    const phase = t < 1 ? 0 : (1 - Math.cos(((t - 1) % 2) * Math.PI)) / 2;
+    const p = phase * (opts.depth ? opts.depth(rep) : 1);
+    frames.push({ t: Math.round(t * 1000), people: opts.people ? opts.people(i) : 1, lm: figure(kind, p, opts.vis), luma: opts.luma ?? 120 });
+  }
+  return frames;
+}
+
+test('angle and rep segmentation', () => {
+  assert.equal(Math.round(angle({ x: 0, y: 1 }, { x: 0, y: 0 }, { x: 1, y: 0 })), 90);
+  const y = [0, 0, 1, 2, 3, 2, 1, 0, 0, 1, 2, 3, 2, 1, 0];
+  assert.equal(segmentReps(y, 2).length, 2);
+  assert.equal(segmentReps([0, 0.1, 0, 0.1, 0], 2).length, 0, 'wobble is not a rep');
+});
+
+test('recognises the supported movements', () => {
+  assert.equal(classify(video('squat')), 'squat');
+  assert.equal(classify(video('hinge')), 'hinge');
+  assert.equal(classify(video('push_up')), 'push_up');
+});
+
+test('squat: counts reps and reports depth, tempo and limits with capped confidence', () => {
+  const r = analyseForm(video('squat', 4), 'squat');
+  assert.ok(r.ok, JSON.stringify(r));
+  assert.equal(r.reps, 4);
+  const depth = r.observations.find((o) => o.title === 'Depth')!;
+  assert.match(depth.detail, /all 4 reps/);
+  assert.ok(r.observations.every((o) => o.confidence === 'low' || o.confidence === 'moderate'), 'never high');
+  assert.match(r.observations.find((o) => o.title === 'Tempo')!.detail, /About 1(\.\d)? s down and 1(\.\d)? s up/);
+  assert.ok(r.limits.some((l) => /cannot tell whether a lift is safe/.test(l)));
+});
+
+test('squat: shallow reps are described without judging them', () => {
+  const r = analyseForm(video('squat', 4, { depth: () => 0.6 }), 'squat');
+  assert.ok(r.ok);
+  assert.match(r.observations.find((o) => o.title === 'Depth')!.detail, /above knee height on all 4 reps.*your choice/);
+});
+
+test('hinge and push-up observations', () => {
+  const h = analyseForm(video('hinge', 3), 'hinge');
+  assert.ok(h.ok, JSON.stringify(h));
+  assert.equal(h.reps, 3);
+  assert.match(h.observations.find((o) => o.title === 'Lockout')!.detail, /all 3 reps/);
+  const p = analyseForm(video('push_up', 3), 'push_up');
+  assert.ok(p.ok, JSON.stringify(p));
+  assert.equal(p.reps, 3);
+});
+
+test('stops instead of guessing: dark, hidden joints, two people, too short, wrong exercise', () => {
+  const dark = analyseForm(video('squat', 4, { luma: 20 }), 'squat');
+  assert.ok(!dark.ok && dark.reason === 'too_dark');
+  const hidden = analyseForm(video('squat', 4, { vis: 0.2 }), 'squat');
+  assert.ok(!hidden.ok && hidden.reason === 'not_visible');
+  const crowd = analyseForm(video('squat', 4, { people: (i) => (i % 3 === 0 ? 2 : 1) }), 'squat');
+  assert.ok(!crowd.ok && crowd.reason === 'multiple_people');
+  const short = analyseForm(video('squat', 4).slice(0, 15), 'squat');
+  assert.ok(!short.ok && short.reason === 'too_short');
+  const nobody = analyseForm(video('squat', 4).map((f, i) => (i % 2 ? { ...f, lm: null, people: 0 } : f)), 'squat');
+  assert.ok(!nobody.ok && nobody.reason === 'no_person');
+  const wrong = analyseForm(video('hinge', 3), 'squat');
+  assert.ok(!wrong.ok && wrong.reason === 'unsupported' && wrong.detected === 'hinge');
+  assert.ok(gate(video('squat'), 'squat').ok);
+});
+
+test('bar speed: close to the known speed, with an honest uncertainty range', () => {
+  const frames = video('squat', 3);
+  const size = { w: 1000, h: 1000 };
+  const r = estimateSpeed(frames, 'squat', 180, size);
+  assert.ok(r.ok, JSON.stringify(r));
+  assert.equal(r.reps.length, 3);
+  // Known: shoulder rises from the bottom to standing in 1 s; scale from torso length = 0.288 x height.
+  const top = figure('squat', 0).ls, bottom = figure('squat', 1).ls;
+  const mPerPx = (0.288 * 1.8) / (0.25 * 1000);
+  const expected = ((bottom.y - top.y) * 1000 * mPerPx) / 1;
+  for (const rep of r.reps) {
+    assert.ok(Math.abs(rep.mps - expected) / expected < 0.15, `rep ${rep.rep}: ${rep.mps} vs ${expected.toFixed(2)}`);
+    assert.ok(rep.low < rep.mps && rep.mps < rep.high, 'range brackets the estimate');
+  }
+  assert.ok(r.uncertainty >= 15, 'never claims better than +/-15%');
+  assert.ok(r.notes.some((n) => /Not validated/.test(n)));
+  const bad = estimateSpeed(frames, 'squat', 0, size);
+  assert.ok(!bad.ok, 'needs a height to calibrate');
+});
