+++ b/supabase/migrations/20261009000000_rpe_crash_reports_community.sql
@@ -0,0 +1,410 @@
+-- Migration 6: optional RPE and bar-speed estimates on sets, client crash reports, and the community
+-- (opt-in profiles, posts, comments, likes, follows, blocks, reports, moderation).
+-- Supabase: SQL Editor -> New query -> paste this file -> Run. Run after migrations 1-5.
+-- Then run supabase/tests/security_tests.sql to verify (it rolls everything back).
+
+-- ───────────── 1. Sets: optional RPE (1-10 in half steps) and a camera bar-speed estimate (m/s) ─────────────
+-- RIR stays the value the engine uses; RPE is what the lifter entered when they chose the RPE scale.
+alter table public.logged_sets
+  add column rpe numeric(3,1) constraint logged_sets_rpe_range check (rpe is null or (rpe between 1 and 10 and rpe * 2 = floor(rpe * 2))),
+  add column velocity numeric(4,2) constraint logged_sets_velocity_range check (velocity is null or (velocity > 0 and velocity <= 3));
+
+-- Same signature and behaviour as migration 4; also stores rpe and velocity when the app sends them.
+create or replace function public.save_workout(
+  p_client_id uuid, p_program_id uuid, p_day_index int, p_day_name text, p_checkin jsonb,
+  p_started_at timestamptz, p_perf_drops int, p_next_day int, p_sets jsonb
+) returns uuid
+language plpgsql security invoker set search_path = '' as $$
+declare
+  wid uuid;
+begin
+  if p_client_id is null then raise exception 'client id required' using errcode = '22023'; end if;
+  if p_sets is null or jsonb_typeof(p_sets) <> 'array' or jsonb_array_length(p_sets) > 100 then
+    raise exception 'invalid sets' using errcode = '22023';
+  end if;
+
+  select id into wid from public.workouts where user_id = auth.uid() and client_id = p_client_id;
+  if wid is not null then return wid; end if; -- retry of a save that already went through
+
+  begin
+    insert into public.workouts (client_id, program_id, day_index, day_name, checkin, started_at, perf_drops)
+      values (p_client_id, p_program_id, p_day_index, p_day_name, p_checkin, p_started_at, p_perf_drops)
+      returning id into wid;
+  exception when unique_violation then
+    select id into wid from public.workouts where user_id = auth.uid() and client_id = p_client_id;
+    return wid;
+  end;
+  insert into public.logged_sets (workout_id, exercise_id, set_index, weight, reps, rir, overridden, rpe, velocity)
+    select wid, s->>'exercise_id', (s->>'set_index')::int, (s->>'weight')::numeric, (s->>'reps')::int,
+           (s->>'rir')::int, coalesce((s->>'overridden')::boolean, false), (s->>'rpe')::numeric, (s->>'velocity')::numeric
+    from jsonb_array_elements(p_sets) as s;
+  update public.programs set next_day = p_next_day where id = p_program_id;
+  return wid;
+end;
+$$;
+revoke execute on function public.save_workout(uuid, uuid, int, text, jsonb, timestamptz, int, int, jsonb) from public, anon;
+grant execute on function public.save_workout(uuid, uuid, int, text, jsonb, timestamptz, int, int, jsonb) to authenticated;
+
+-- ───────────── 2. Client crash reports (insert-only; no passwords, tokens or health data) ─────────────
+-- The app scrubs messages before sending (src/lib/crash.ts); these caps bound whatever arrives.
+create table public.client_errors (
+  id bigint generated always as identity primary key,
+  user_id uuid not null references auth.users on delete cascade default auth.uid(),
+  message text not null check (char_length(message) <= 500),
+  stack text check (char_length(stack) <= 4000),
+  context jsonb check (context is null or octet_length(context::text) <= 1024),
+  created_at timestamptz not null default now()
+);
+alter table public.client_errors enable row level security;
+create policy insert_own on public.client_errors for insert with check (user_id = auth.uid());
+revoke all on public.client_errors from anon, authenticated;
+grant insert (message, stack, context) on public.client_errors to authenticated;
+create trigger rate_limit before insert on public.client_errors for each row execute function private.enforce_write_limit('50', '1 day');
+
+-- ───────────── 3. Community ─────────────
+-- Opt-in: nothing is public until a member creates a community profile. Reading needs a signed-in user.
+create table public.community_profiles (
+  user_id uuid primary key references auth.users on delete cascade default auth.uid(),
+  handle text not null unique check (handle ~ '^[a-z0-9_]{3,20}$'),
+  display_name text not null check (char_length(btrim(display_name)) between 1 and 40),
+  bio text check (char_length(bio) <= 160),
+  show_stats boolean not null default false, -- privacy: training stats hidden unless the member turns this on
+  accepted_rules_at timestamptz not null default now(),
+  banned_until timestamptz, -- moderators only
+  created_at timestamptz not null default now()
+);
+
+create table public.posts (
+  id uuid primary key default gen_random_uuid(),
+  user_id uuid not null references public.community_profiles (user_id) on delete cascade default auth.uid(),
+  body text not null check (char_length(btrim(body)) between 1 and 2000),
+  topic text not null default 'general' check (topic in ('general', 'training', 'nutrition', 'progress', 'question')),
+  status text not null default 'visible' check (status in ('visible', 'held', 'removed')),
+  held_reason text check (char_length(held_reason) <= 200),
+  like_count int not null default 0,
+  comment_count int not null default 0,
+  created_at timestamptz not null default now(),
+  edited_at timestamptz
+);
+create index posts_feed on public.posts (created_at desc) where status = 'visible';
+create index posts_author on public.posts (user_id, created_at desc);
+
+create table public.comments (
+  id uuid primary key default gen_random_uuid(),
+  post_id uuid not null references public.posts on delete cascade,
+  user_id uuid not null references public.community_profiles (user_id) on delete cascade default auth.uid(),
+  body text not null check (char_length(btrim(body)) between 1 and 1000),
+  status text not null default 'visible' check (status in ('visible', 'held', 'removed')),
+  held_reason text check (char_length(held_reason) <= 200),
+  created_at timestamptz not null default now()
+);
+create index comments_post on public.comments (post_id, created_at);
+
+create table public.post_likes (
+  post_id uuid not null references public.posts on delete cascade,
+  user_id uuid not null references public.community_profiles (user_id) on delete cascade default auth.uid(),
+  created_at timestamptz not null default now(),
+  primary key (post_id, user_id)
+);
+
+create table public.follows (
+  follower_id uuid not null references public.community_profiles (user_id) on delete cascade default auth.uid(),
+  followee_id uuid not null references public.community_profiles (user_id) on delete cascade,
+  created_at timestamptz not null default now(),
+  primary key (follower_id, followee_id),
+  check (follower_id <> followee_id)
+);
+
+create table public.blocks (
+  blocker_id uuid not null references auth.users on delete cascade default auth.uid(),
+  blocked_id uuid not null references auth.users on delete cascade,
+  created_at timestamptz not null default now(),
+  primary key (blocker_id, blocked_id),
+  check (blocker_id <> blocked_id)
+);
+
+create table public.reports (
+  id uuid primary key default gen_random_uuid(),
+  reporter_id uuid not null references auth.users on delete cascade default auth.uid(),
+  post_id uuid references public.posts on delete cascade,
+  comment_id uuid references public.comments on delete cascade,
+  reported_user uuid references public.community_profiles (user_id) on delete cascade,
+  reason text not null check (reason in ('harassment', 'medical_misinformation', 'unsafe_training', 'steroids', 'supplement_dosing', 'spam', 'other')),
+  details text check (char_length(details) <= 500),
+  status text not null default 'open' check (status in ('open', 'actioned', 'dismissed')),
+  created_at timestamptz not null default now(),
+  check (num_nonnulls(post_id, comment_id, reported_user) = 1)
+);
+-- One report per member per target: repeated reports cannot pile onto one post.
+create unique index reports_once on public.reports (reporter_id, coalesce(post_id, comment_id, reported_user));
+create index reports_open on public.reports (created_at) where status = 'open';
+
+-- Moderators are added by the project owner in the SQL Editor:
+--   insert into public.moderators (user_id) values ('<auth user id>');
+create table public.moderators (
+  user_id uuid primary key references auth.users on delete cascade,
+  added_at timestamptz not null default now()
+);
+
+create table public.moderation_actions (
+  id bigint generated always as identity primary key,
+  moderator_id uuid references auth.users on delete set null,
+  action text not null,
+  post_id uuid,
+  comment_id uuid,
+  target_user uuid,
+  report_id uuid,
+  note text check (char_length(note) <= 500),
+  created_at timestamptz not null default now()
+);
+
+-- ── helpers: each answers a question about the caller only ──
+create function public.is_moderator() returns boolean
+language sql stable security definer set search_path = '' as $$
+  select exists (select 1 from public.moderators where user_id = auth.uid());
+$$;
+
+-- True when either member has blocked the other (sees both directions; the caller can only read their own blocks).
+create function public.is_blocked_with(other uuid) returns boolean
+language sql stable security definer set search_path = '' as $$
+  select exists (select 1 from public.blocks
+    where (blocker_id = auth.uid() and blocked_id = other) or (blocker_id = other and blocked_id = auth.uid()));
+$$;
+
+-- The caller has a community profile and is not banned.
+create function public.can_participate() returns boolean
+language sql stable security definer set search_path = '' as $$
+  select exists (select 1 from public.community_profiles
+    where user_id = auth.uid() and (banned_until is null or banned_until < now()));
+$$;
+
+revoke execute on function public.is_moderator(), public.is_blocked_with(uuid), public.can_participate() from public, anon;
+grant execute on function public.is_moderator(), public.is_blocked_with(uuid), public.can_participate() to authenticated;
+
+-- ── content rules enforced on the server: links, drug and dosing talk are held for a moderator ──
+-- Community rules forbid steroid/PED promotion and supplement or drug dosing; a match is held, not deleted,
+-- so a false positive costs a short wait rather than a lost post.
+create function private.flag_reason(body text) returns text
+language sql immutable set search_path = '' as $$
+  select case
+    when body ~* '(https?://|www\.|\m[a-z0-9-]+\.(com|net|org|io|co|shop|store|link)\M)' then 'Contains a link'
+    when body ~* '\m(steroids?|anabolics?|trenbolone|tren|testosterone (cypionate|enanthate|propionate)|test (e|c|cyp|prop)|anavar|oxandrolone|dianabol|dbol|winstrol|stanozolol|deca|nandrolone|sarms?|ostarine|rad[- ]?140|lgd[- ]?4033|cardarine|clenbuterol|clen|hgh|peptides?|pct|blast and cruise|cruising)\M'
+      then 'Mentions performance-enhancing drugs'
+    when body ~* '\m[0-9]+([.,][0-9]+)?\s?(mg|mcg|µg|ug|iu|ml|cc)\M' then 'Mentions a dose'
+    else null
+  end;
+$$;
+revoke all on function private.flag_reason(text) from public, anon, authenticated;
+
+create function private.screen_content() returns trigger
+language plpgsql security definer set search_path = '' as $$
+declare r text := private.flag_reason(new.body);
+begin
+  -- Only ever escalates: an edit cannot release held or removed content.
+  if r is not null and new.status = 'visible' then
+    new.status := 'held';
+    new.held_reason := r;
+  end if;
+  if tg_op = 'UPDATE' then new.edited_at := now(); end if;
+  return new;
+end;
+$$;
+revoke all on function private.screen_content() from public, anon, authenticated;
+create trigger screen_content before insert or update of body on public.posts for each row execute function private.screen_content();
+create trigger screen_content before insert on public.comments for each row execute function private.screen_content();
+
+-- Counters kept by the server (members cannot write them).
+create function private.count_likes() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  if tg_op = 'INSERT' then update public.posts set like_count = like_count + 1 where id = new.post_id;
+  else update public.posts set like_count = greatest(0, like_count - 1) where id = old.post_id; end if;
+  return null;
+end;
+$$;
+create function private.count_comments() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  if tg_op = 'INSERT' then update public.posts set comment_count = comment_count + 1 where id = new.post_id;
+  else update public.posts set comment_count = greatest(0, comment_count - 1) where id = old.post_id; end if;
+  return null;
+end;
+$$;
+revoke all on function private.count_likes(), private.count_comments() from public, anon, authenticated;
+create trigger count_likes after insert or delete on public.post_likes for each row execute function private.count_likes();
+create trigger count_comments after insert or delete on public.comments for each row execute function private.count_comments();
+
+-- Blocking someone also ends any follow between the two members.
+create function private.block_cleanup() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  delete from public.follows
+    where (follower_id = new.blocker_id and followee_id = new.blocked_id) or (follower_id = new.blocked_id and followee_id = new.blocker_id);
+  return null;
+end;
+$$;
+revoke all on function private.block_cleanup() from public, anon, authenticated;
+create trigger block_cleanup after insert on public.blocks for each row execute function private.block_cleanup();
+
+-- Three open reports from different members hold a post or comment until a moderator looks.
+create function private.hold_reported() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  if new.post_id is not null and (select count(*) from public.reports where post_id = new.post_id and status = 'open') >= 3 then
+    update public.posts set status = 'held', held_reason = 'Reported by several members' where id = new.post_id and status = 'visible';
+  end if;
+  if new.comment_id is not null and (select count(*) from public.reports where comment_id = new.comment_id and status = 'open') >= 3 then
+    update public.comments set status = 'held', held_reason = 'Reported by several members' where id = new.comment_id and status = 'visible';
+  end if;
+  return null;
+end;
+$$;
+revoke all on function private.hold_reported() from public, anon, authenticated;
+create trigger hold_reported after insert on public.reports for each row execute function private.hold_reported();
+
+-- ── row-level security ──
+alter table public.community_profiles enable row level security;
+alter table public.posts enable row level security;
+alter table public.comments enable row level security;
+alter table public.post_likes enable row level security;
+alter table public.follows enable row level security;
+alter table public.blocks enable row level security;
+alter table public.reports enable row level security;
+alter table public.moderators enable row level security;
+alter table public.moderation_actions enable row level security;
+
+create policy read on public.community_profiles for select using (user_id = auth.uid() or not public.is_blocked_with(user_id));
+create policy own_insert on public.community_profiles for insert with check (user_id = auth.uid());
+create policy own_update on public.community_profiles for update using (user_id = auth.uid()) with check (user_id = auth.uid());
+create policy own_delete on public.community_profiles for delete using (user_id = auth.uid());
+
+create policy read on public.posts for select using (
+  user_id = auth.uid() or public.is_moderator() or (status = 'visible' and not public.is_blocked_with(user_id)));
+create policy own_insert on public.posts for insert with check (user_id = auth.uid() and public.can_participate());
+create policy own_update on public.posts for update using (user_id = auth.uid()) with check (user_id = auth.uid() and public.can_participate());
+create policy own_delete on public.posts for delete using (user_id = auth.uid());
+
+create policy read on public.comments for select using (
+  user_id = auth.uid() or public.is_moderator()
+  or (status = 'visible' and not public.is_blocked_with(user_id)
+      and exists (select 1 from public.posts p where p.id = post_id)));
+create policy own_insert on public.comments for insert with check (
+  user_id = auth.uid() and public.can_participate()
+  and exists (select 1 from public.posts p where p.id = post_id and p.status = 'visible' and not public.is_blocked_with(p.user_id)));
+create policy own_delete on public.comments for delete using (user_id = auth.uid());
+
+-- Likes are private: members see only their own (posts carry the count).
+create policy own on public.post_likes for select using (user_id = auth.uid());
+create policy own_insert on public.post_likes for insert with check (
+  user_id = auth.uid() and public.can_participate()
+  and exists (select 1 from public.posts p where p.id = post_id and p.status = 'visible' and not public.is_blocked_with(p.user_id)));
+create policy own_delete on public.post_likes for delete using (user_id = auth.uid());
+
+-- Follow lists are private to the two members involved.
+create policy mine on public.follows for select using (follower_id = auth.uid() or followee_id = auth.uid());
+create policy own_insert on public.follows for insert with check (
+  follower_id = auth.uid() and public.can_participate() and not public.is_blocked_with(followee_id));
+create policy own_delete on public.follows for delete using (follower_id = auth.uid());
+
+create policy own on public.blocks for select using (blocker_id = auth.uid());
+create policy own_insert on public.blocks for insert with check (blocker_id = auth.uid());
+create policy own_delete on public.blocks for delete using (blocker_id = auth.uid());
+
+create policy read on public.reports for select using (reporter_id = auth.uid() or public.is_moderator());
+create policy own_insert on public.reports for insert with check (reporter_id = auth.uid());
+
+create policy moderators_read on public.moderation_actions for select using (public.is_moderator());
+-- public.moderators: no policies, no grants. Only the SQL Editor (owner) manages moderators.
+
+-- ── grants: members write only the columns they own ──
+revoke all on public.community_profiles, public.posts, public.comments, public.post_likes, public.follows, public.blocks,
+  public.reports, public.moderators, public.moderation_actions from anon, authenticated;
+grant select, delete on public.community_profiles to authenticated;
+grant insert (handle, display_name, bio, show_stats), update (handle, display_name, bio, show_stats) on public.community_profiles to authenticated;
+grant select, delete on public.posts to authenticated;
+grant insert (body, topic), update (body) on public.posts to authenticated;
+grant select, delete on public.comments to authenticated;
+grant insert (post_id, body) on public.comments to authenticated;
+grant select, delete on public.post_likes to authenticated;
+grant insert (post_id) on public.post_likes to authenticated;
+grant select, delete on public.follows to authenticated;
+grant insert (followee_id) on public.follows to authenticated;
+grant select, delete on public.blocks to authenticated;
+grant insert (blocked_id) on public.blocks to authenticated;
+grant select on public.reports to authenticated;
+grant insert (post_id, comment_id, reported_user, reason, details) on public.reports to authenticated;
+grant select on public.moderation_actions to authenticated;
+
+-- ── abuse limits (same per-user counters as migration 4) ──
+create trigger rate_limit before insert on public.community_profiles for each row execute function private.enforce_write_limit('5', '1 day');
+create trigger rate_limit_update before update on public.community_profiles for each row execute function private.enforce_write_limit('30', '1 day');
+create trigger rate_limit before insert on public.posts for each row execute function private.enforce_write_limit('10', '1 day');
+-- Only edits count: like and comment counters also update posts.
+create trigger rate_limit_update before update of body on public.posts for each row execute function private.enforce_write_limit('30', '1 day');
+create trigger rate_limit before insert on public.comments for each row execute function private.enforce_write_limit('60', '1 day');
+create trigger rate_limit before insert on public.post_likes for each row execute function private.enforce_write_limit('300', '1 day');
+create trigger rate_limit before insert on public.follows for each row execute function private.enforce_write_limit('100', '1 day');
+create trigger rate_limit before insert on public.blocks for each row execute function private.enforce_write_limit('50', '1 day');
+create trigger rate_limit before insert on public.reports for each row execute function private.enforce_write_limit('30', '1 day');
+
+-- ── moderation (moderators only; every action is logged) ──
+create function public.moderate(p_kind text, p_id uuid, p_status text, p_note text default null) returns void
+language plpgsql security definer set search_path = '' as $$
+declare uid uuid := auth.uid();
+begin
+  if not public.is_moderator() then raise exception 'not a moderator' using errcode = '42501'; end if;
+  if p_status not in ('visible', 'held', 'removed') then raise exception 'invalid status' using errcode = '22023'; end if;
+  if p_kind = 'post' then
+    update public.posts set status = p_status, held_reason = case when p_status = 'visible' then null else coalesce(p_note, held_reason) end where id = p_id;
+    update public.reports set status = case when p_status = 'visible' then 'dismissed' else 'actioned' end where post_id = p_id and status = 'open';
+    insert into public.moderation_actions (moderator_id, action, post_id, note) values (uid, 'post_' || p_status, p_id, p_note);
+  elsif p_kind = 'comment' then
+    update public.comments set status = p_status, held_reason = case when p_status = 'visible' then null else coalesce(p_note, held_reason) end where id = p_id;
+    update public.reports set status = case when p_status = 'visible' then 'dismissed' else 'actioned' end where comment_id = p_id and status = 'open';
+    insert into public.moderation_actions (moderator_id, action, comment_id, note) values (uid, 'comment_' || p_status, p_id, p_note);
+  else
+    raise exception 'invalid kind' using errcode = '22023';
+  end if;
+end;
+$$;
+
+create function public.resolve_report(p_report uuid, p_status text) returns void
+language plpgsql security definer set search_path = '' as $$
+begin
+  if not public.is_moderator() then raise exception 'not a moderator' using errcode = '42501'; end if;
+  if p_status not in ('actioned', 'dismissed') then raise exception 'invalid status' using errcode = '22023'; end if;
+  update public.reports set status = p_status where id = p_report;
+  insert into public.moderation_actions (moderator_id, action, report_id) values (auth.uid(), 'report_' || p_status, p_report);
+end;
+$$;
+
+-- p_days = 0 lifts a ban. p_remove_content also removes everything the member posted.
+create function public.ban_member(p_user uuid, p_days int, p_remove_content boolean default false, p_note text default null) returns void
+language plpgsql security definer set search_path = '' as $$
+begin
+  if not public.is_moderator() then raise exception 'not a moderator' using errcode = '42501'; end if;
+  if p_days < 0 or p_days > 3650 then raise exception 'invalid ban length' using errcode = '22023'; end if;
+  update public.community_profiles set banned_until = case when p_days = 0 then null else now() + make_interval(days => p_days) end where user_id = p_user;
+  if p_remove_content then
+    update public.posts set status = 'removed', held_reason = 'Removed by a moderator' where user_id = p_user and status <> 'removed';
+    update public.comments set status = 'removed', held_reason = 'Removed by a moderator' where user_id = p_user and status <> 'removed';
+  end if;
+  insert into public.moderation_actions (moderator_id, action, target_user, note)
+    values (auth.uid(), case when p_days = 0 then 'unban' else 'ban_' || p_days || 'd' end, p_user, p_note);
+end;
+$$;
+revoke execute on function public.moderate(text, uuid, text, text), public.resolve_report(uuid, text), public.ban_member(uuid, int, boolean, text) from public, anon;
+grant execute on function public.moderate(text, uuid, text, text), public.resolve_report(uuid, text), public.ban_member(uuid, int, boolean, text) to authenticated;
+
+-- Training stats on a profile, only when that member opted in (show_stats) and neither has blocked the other.
+create function public.community_stats(p_user uuid) returns table (workouts_30d bigint, last_workout date)
+language sql stable security definer set search_path = '' as $$
+  select count(*), max(w.finished_at)::date
+  from public.workouts w
+  where w.user_id = p_user and w.finished_at > now() - interval '30 days'
+    and auth.uid() is not null
+    and exists (select 1 from public.community_profiles c where c.user_id = p_user and c.show_stats)
+    and not public.is_blocked_with(p_user);
+$$;
+revoke execute on function public.community_stats(uuid) from public, anon;
+grant execute on function public.community_stats(uuid) to authenticated;
