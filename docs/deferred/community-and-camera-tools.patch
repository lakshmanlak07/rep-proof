+// Community rules and the client-side copy of the server's content screen (migration 6, private.flag_reason).
+// The server is what enforces it; this copy only warns before posting. Pure; tested in security.test.ts.
+
+export const RULES: { title: string; body: string }[] = [
+  { title: 'Be respectful', body: 'No harassment, insults, threats, hate or body-shaming. Disagree with ideas, not people.' },
+  { title: 'No medical advice or misinformation', body: 'Do not diagnose, treat or advise on injuries, pain or medical conditions. Point people to a qualified professional.' },
+  { title: 'No unsafe training advice', body: 'No encouraging training through pain, extreme dieting, dehydration or dangerous stunts.' },
+  { title: 'No steroids or other performance-enhancing drugs', body: 'No promoting, sourcing or "cycle" advice for steroids, SARMs, peptides or similar drugs.' },
+  { title: 'No supplement or drug dosing', body: 'Talk about experiences, but do not tell others how much of any supplement or drug to take.' },
+  { title: 'Posts are opinions, not evidence', body: 'Share what worked for you, but do not present it as proof. RepProof never changes anyone\'s plan from a post.' },
+  { title: 'No spam or links', body: 'No ads, referral codes or links. Posts with links are held for review.' },
+];
+
+export const REPORT_REASONS = [
+  { value: 'harassment', label: 'Harassment or hate' },
+  { value: 'medical_misinformation', label: 'Medical misinformation' },
+  { value: 'unsafe_training', label: 'Unsafe training advice' },
+  { value: 'steroids', label: 'Steroid or drug promotion' },
+  { value: 'supplement_dosing', label: 'Supplement or drug dosing' },
+  { value: 'spam', label: 'Spam or advertising' },
+  { value: 'other', label: 'Something else' },
+] as const;
+export type ReportReason = (typeof REPORT_REASONS)[number]['value'];
+
+// Same patterns as the SQL (Postgres \m \M word boundaries become \b here).
+const LINK = /(https?:\/\/|www\.|\b[a-z0-9-]+\.(com|net|org|io|co|shop|store|link)\b)/i;
+const PEDS = /\b(steroids?|anabolics?|trenbolone|tren|testosterone (cypionate|enanthate|propionate)|test (e|c|cyp|prop)|anavar|oxandrolone|dianabol|dbol|winstrol|stanozolol|deca|nandrolone|sarms?|ostarine|rad[- ]?140|lgd[- ]?4033|cardarine|clenbuterol|clen|hgh|peptides?|pct|blast and cruise|cruising)\b/i;
+const DOSE = /\b[0-9]+([.,][0-9]+)?\s?(mg|mcg|µg|ug|iu|ml|cc)\b/i;
+
+/** Why a post would be held for review, or null. */
+export function flagReason(body: string): string | null {
+  if (LINK.test(body)) return 'Contains a link';
+  if (PEDS.test(body)) return 'Mentions performance-enhancing drugs';
+  if (DOSE.test(body)) return 'Mentions a dose';
+  return null;
+}
+
+export const HANDLE = /^[a-z0-9_]{3,20}$/;
diff --git a/supabase/migrations/20261009000000_rpe_crash_reports_community.sql b/supabase/migrations/20261009000000_rpe_crash_reports_community.sql
