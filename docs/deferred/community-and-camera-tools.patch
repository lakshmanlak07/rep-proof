+// Web: the pose page in an iframe (same-origin srcdoc, camera allowed). Messages come back via postMessage.
+import { useEffect, useRef } from 'react';
+
+import { POSE_HTML, type PoseMsg } from './poseHtml';
+
+type PoseWindow = Window & { cmd?: (c: string, arg?: string) => void };
+
+export function PoseCamera({ facing, recording, onMessage }: { facing: 'user' | 'environment'; recording: boolean; onMessage: (m: PoseMsg) => void }) {
+  const ref = useRef<HTMLIFrameElement>(null);
+  const handler = useRef(onMessage);
+  useEffect(() => { handler.current = onMessage; });
+  const cmd = (c: string, arg?: string) => (ref.current?.contentWindow as PoseWindow | null)?.cmd?.(c, arg);
+
+  useEffect(() => {
+    const listen = (e: MessageEvent) => {
+      if (e.source !== ref.current?.contentWindow || typeof e.data?.__pose !== 'string') return;
+      let m: PoseMsg;
+      try { m = JSON.parse(e.data.__pose); } catch { return; }
+      if (m.type === 'loaded') cmd('start', facing);
+      handler.current(m);
+    };
+    window.addEventListener('message', listen);
+    return () => { window.removeEventListener('message', listen); cmd('close'); };
+  }, [facing]);
+  useEffect(() => { cmd(recording ? 'record' : 'pause'); }, [recording]);
+
+  return <iframe ref={ref} srcDoc={POSE_HTML} allow="camera" title="Camera" style={{ border: 0, width: '100%', height: '100%', flex: 1, backgroundColor: '#2A1620' }} />;
+}
diff --git a/src/camera/poseHtml.ts b/src/camera/poseHtml.ts
new file mode 100644
index 0000000..f4b3d66
--- /dev/null
+++ b/src/camera/poseHtml.ts
@@ -0,0 +1,88 @@
+// The page that runs the on-device pose model inside a WebView (Android/iOS) or an iframe (web).
+// Video never leaves this page: frames go to the model in memory and only landmark coordinates are posted to
+// the app. Nothing is recorded or uploaded. The model and its runtime are downloaded from Google's model
+// storage and jsDelivr on first use (about 18 MB; the browser caches them).
+export const MEDIAPIPE_VERSION = '1.1.0';
+const CDN = `https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@${MEDIAPIPE_VERSION}`;
+const MODEL = 'https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task';
+
+export type PoseMsg =
+  | { type: 'loaded' }
+  | { type: 'ready'; w: number; h: number }
+  | { type: 'preview'; people: number }
+  | { type: 'frame'; t: number; n: number; lm: number[] | null; luma?: number }
+  | { type: 'error'; code: 'unsupported' | 'camera_denied' | 'camera_unavailable' | 'model_failed'; detail?: string };
+
+export const POSE_HTML = `<!doctype html><html><head><meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
+<style>html,body{margin:0;height:100%;background:#2A1620;overflow:hidden}
+video,canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}</style></head>
+<body><video id="v" playsinline muted autoplay></video><canvas id="c"></canvas>
+<script type="module">
+const send = (m) => { const s = JSON.stringify(m); if (window.ReactNativeWebView) window.ReactNativeWebView.postMessage(s); else if (window.parent !== window) window.parent.postMessage({ __pose: s }, '*'); };
+const IDX = [0, 11, 12, 13, 14, 15, 16, 23, 24, 25, 26, 27, 28];
+const LINES = [[11,12],[11,13],[13,15],[12,14],[14,16],[11,23],[12,24],[23,24],[23,25],[25,27],[24,26],[26,28]];
+const video = document.getElementById('v'), canvas = document.getElementById('c'), ctx = canvas.getContext('2d');
+const small = document.createElement('canvas'); small.width = 24; small.height = 24; const sctx = small.getContext('2d', { willReadFrequently: true });
+let lm = null, stream = null, recording = false, last = 0, lastPreview = 0, frames = 0, stopped = false;
+const r4 = (x) => Math.round(x * 10000) / 10000;
+function luma() {
+  sctx.drawImage(video, 0, 0, 24, 24);
+  const d = sctx.getImageData(0, 0, 24, 24).data; let s = 0;
+  for (let i = 0; i < d.length; i += 4) s += 0.299 * d[i] + 0.587 * d[i + 1] + 0.114 * d[i + 2];
+  return Math.round(s / (d.length / 4));
+}
+function draw(people) {
+  canvas.width = video.videoWidth; canvas.height = video.videoHeight;
+  ctx.clearRect(0, 0, canvas.width, canvas.height);
+  people.forEach((p, k) => {
+    ctx.strokeStyle = k ? '#F5B942' : '#F7E8EC'; ctx.fillStyle = k ? '#F5B942' : '#C2315F'; ctx.lineWidth = Math.max(3, canvas.width / 160);
+    for (const [a, b] of LINES) { if (p[a].visibility < 0.4 || p[b].visibility < 0.4) continue; ctx.beginPath(); ctx.moveTo(p[a].x * canvas.width, p[a].y * canvas.height); ctx.lineTo(p[b].x * canvas.width, p[b].y * canvas.height); ctx.stroke(); }
+    for (const i of IDX) { if (p[i].visibility < 0.4) continue; ctx.beginPath(); ctx.arc(p[i].x * canvas.width, p[i].y * canvas.height, ctx.lineWidth * 1.6, 0, 7); ctx.fill(); }
+  });
+}
+function loop() {
+  if (stopped) return;
+  requestAnimationFrame(loop);
+  const now = performance.now();
+  if (now - last < 66 || video.readyState < 2) return; // about 15 frames a second
+  last = now;
+  let r; try { r = lm.detectForVideo(video, now); } catch (e) { return; }
+  const people = r.landmarks || [];
+  draw(people);
+  if (!recording) { if (now - lastPreview > 700) { lastPreview = now; send({ type: 'preview', people: people.length }); } return; }
+  const p = people[0];
+  const m = { type: 'frame', t: Math.round(now), n: people.length, lm: p ? IDX.flatMap((i) => [r4(p[i].x), r4(p[i].y), Math.round((p[i].visibility ?? 0) * 100) / 100]) : null };
+  if (frames++ % 8 === 0) m.luma = luma();
+  send(m);
+}
+async function start(facing) {
+  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) return send({ type: 'error', code: 'unsupported' });
+  try {
+    stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: facing, width: { ideal: 640 }, height: { ideal: 480 } }, audio: false });
+  } catch (e) {
+    return send({ type: 'error', code: e && e.name === 'NotAllowedError' ? 'camera_denied' : 'camera_unavailable', detail: String(e && e.name) });
+  }
+  video.srcObject = stream;
+  try { await video.play(); } catch (e) {}
+  try {
+    const { FilesetResolver, PoseLandmarker } = await import('${CDN}/vision_bundle.mjs');
+    const files = await FilesetResolver.forVisionTasks('${CDN}/wasm');
+    lm = await PoseLandmarker.createFromOptions(files, {
+      baseOptions: { modelAssetPath: '${MODEL}', delegate: 'CPU' },
+      runningMode: 'VIDEO', numPoses: 2, minPoseDetectionConfidence: 0.5, minPosePresenceConfidence: 0.5, minTrackingConfidence: 0.5,
+    });
+  } catch (e) {
+    return send({ type: 'error', code: 'model_failed', detail: String(e && e.message).slice(0, 120) });
+  }
+  send({ type: 'ready', w: video.videoWidth, h: video.videoHeight });
+  loop();
+}
+window.cmd = (c, arg) => {
+  if (c === 'start') start(arg || 'environment');
+  if (c === 'record') { frames = 0; recording = true; }
+  if (c === 'pause') recording = false;
+  if (c === 'close') { stopped = true; recording = false; if (stream) stream.getTracks().forEach((t) => t.stop()); }
+};
+send({ type: 'loaded' });
+</script></body></html>`;
