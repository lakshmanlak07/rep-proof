+++ b/src/camera/CameraLab.tsx
@@ -0,0 +1,240 @@
+import 'expo-sqlite/localStorage/install';
+
+// Camera tools: technique check and bar-speed estimate. Optional, consent-based, never required to log or
+// finish a workout. Video is processed on the device (see poseHtml.ts); only derived numbers are shown, and a
+// bar-speed reading is attached to a set only when the user taps to attach it.
+import Ionicons from '@expo/vector-icons/Ionicons';
+import { Camera } from 'expo-camera';
+import { useRef, useState } from 'react';
+import { Linking, Platform, View } from 'react-native';
+
+import {
+  analyseForm, estimateSpeed, FORM_EXERCISES, KEYS, SPEED_EXERCISES, type FormExercise, type FormResult, type Frame, type Key, type Point,
+  type SpeedExercise, type SpeedResult,
+} from '@/engine/pose.ts';
+import { track } from '@/lib/data';
+import { Banner, Button, C, Card, Chip, Choice, Field, IconButton, s, Screen, Segmented, T } from '@/ui';
+import { Badge, Why } from '@/why';
+import { PoseCamera } from './PoseCamera';
+import type { PoseMsg } from './poseHtml';
+
+export type Mode = 'form' | 'speed';
+const CONSENT = 'camera_consent_v1';
+
+const ERRORS: Record<Extract<PoseMsg, { type: 'error' }>['code'], string> = {
+  camera_denied: 'Camera access is off for RepProof. Turn it on in your phone settings to use camera tools. Manual logging works as normal.',
+  camera_unavailable: 'No usable camera was found on this device. Manual logging works as normal.',
+  unsupported: 'This device or browser cannot run the camera tools. Manual logging works as normal.',
+  model_failed: 'The pose model could not load. It needs an internet connection the first time. Manual logging works as normal.',
+};
+
+function toFrame(m: Extract<PoseMsg, { type: 'frame' }>): Frame {
+  let lm: Record<Key, Point> | null = null;
+  if (m.lm && m.lm.length === KEYS.length * 3) {
+    lm = {} as Record<Key, Point>;
+    KEYS.forEach((k, i) => { lm![k] = { x: m.lm![i * 3], y: m.lm![i * 3 + 1], v: m.lm![i * 3 + 2] }; });
+  }
+  return { t: m.t, people: m.n, lm, luma: m.luma };
+}
+
+export function CameraLab({ mode: initialMode = 'form', formExercise, speedExercise, heightCm, onClose, onVelocity }: {
+  mode?: Mode; formExercise?: FormExercise; speedExercise?: SpeedExercise; heightCm: number;
+  onClose: () => void; onVelocity?: (mps: number) => void;
+}) {
+  const [consent, setConsent] = useState(() => localStorage.getItem(CONSENT) === 'yes');
+  const [agreed, setAgreed] = useState(false);
+  const [mode, setMode] = useState<Mode>(initialMode);
+  const [formEx, setFormEx] = useState<FormExercise>(formExercise ?? 'squat');
+  const [speedEx, setSpeedEx] = useState<SpeedExercise>(speedExercise ?? 'squat');
+  const [height, setHeight] = useState(String(heightCm || ''));
+  const [stage, setStage] = useState<'setup' | 'camera' | 'result'>('setup');
+  const [facing, setFacing] = useState<'environment' | 'user'>('environment');
+  const [status, setStatus] = useState<'loading' | 'ready' | 'recording'>('loading');
+  const [people, setPeople] = useState(0);
+  const [error, setError] = useState<string | null>(null);
+  const [form, setForm] = useState<FormResult | null>(null);
+  const [speed, setSpeed] = useState<SpeedResult | null>(null);
+  const [attached, setAttached] = useState(false);
+  const frames = useRef<Frame[]>([]);
+  const size = useRef({ w: 640, h: 480 });
+
+  async function openCamera() {
+    setError(null);
+    if (Platform.OS !== 'web') {
+      const p = await Camera.requestCameraPermissionsAsync().catch(() => null);
+      if (!p?.granted) { setError(ERRORS.camera_denied); return; }
+    }
+    frames.current = [];
+    setStatus('loading');
+    setStage('camera');
+    track('camera_tool_opened', { mode });
+  }
+
+  function onMessage(m: PoseMsg) {
+    if (m.type === 'ready') { size.current = { w: m.w || 640, h: m.h || 480 }; setStatus('ready'); }
+    if (m.type === 'preview') setPeople(m.people);
+    if (m.type === 'frame' && frames.current.length < 2700) frames.current.push(toFrame(m)); // 3 minutes at 15 fps
+    if (m.type === 'error') { setError(ERRORS[m.code]); setStage('setup'); track('camera_tool_error', { code: m.code }); }
+  }
+
+  function stop() {
+    const f = frames.current;
+    if (mode === 'form') { const r = analyseForm(f, formEx); setForm(r); setSpeed(null); track('form_check', { exercise: formEx, ok: r.ok, reason: r.ok ? null : r.reason }); }
+    else { const r = estimateSpeed(f, speedEx, Number(height), size.current); setSpeed(r); setForm(null); track('bar_speed', { exercise: speedEx, ok: r.ok, reason: r.ok ? null : r.reason }); }
+    setStatus('ready');
+    setStage('result');
+  }
+
+  // ── consent ──
+  if (!consent) {
+    return (
+      <Screen>
+        <View style={[s.row, { justifyContent: 'space-between' }]}>
+          <T size="xl" style={{ flex: 1 }}>Camera tools</T>
+          <IconButton icon="close" label="Close" onPress={onClose} />
+        </View>
+        <Card variant="tint">
+          <T bold>Before you start</T>
+          <T>• Video is processed on this phone, in memory. It is never recorded, saved or uploaded.</T>
+          <T>• The first time, the pose model (about 18 MB) downloads from Google and jsDelivr. They see a normal download request, not your video.</T>
+          <T>• Results are rough estimates with stated uncertainty. They are not validated against lab equipment.</T>
+          <T>• This is not medical, injury or diagnostic advice. It cannot tell you whether a lift is safe. If something hurts, stop and see a qualified professional.</T>
+          <T>• Optional: manual logging always works without it.</T>
+        </Card>
+        <Choice value={agreed ? ['yes'] : []} onChange={() => setAgreed(!agreed)} options={[{ value: 'yes', label: 'I understand and want to use the camera tools' }]} />
+        <Button kind="primary" title="Continue" disabled={!agreed} onPress={() => { localStorage.setItem(CONSENT, 'yes'); setConsent(true); track('camera_consent'); }} />
+        <Button kind="ghost" title="Not now" onPress={onClose} />
+      </Screen>
+    );
+  }
+
+  // ── camera ──
+  if (stage === 'camera') {
+    const recording = status === 'recording';
+    return (
+      <View style={{ flex: 1, backgroundColor: '#2A1620' }}>
+        <PoseCamera key={facing} facing={facing} recording={recording} onMessage={onMessage} />
+        <View style={{ position: 'absolute', top: 48, left: 16, right: 16, gap: 8 }}>
+          <View style={[s.row, { justifyContent: 'space-between' }]}>
+            <IconButton icon="close" label="Stop camera" onPress={() => setStage('setup')} />
+            <Chip tone={status === 'loading' ? 'neutral' : people === 1 ? 'pos' : 'warn'}
+              label={status === 'loading' ? 'Loading pose model…' : recording ? `Recording · ${people === 1 ? 'tracking you' : people > 1 ? 'more than one person' : 'no person seen'}`
+                : people === 1 ? 'Ready: one person in view' : people > 1 ? 'More than one person in view' : 'Step into view'} />
+            <IconButton icon="camera-reverse-outline" label="Switch camera" onPress={() => { setFacing(facing === 'user' ? 'environment' : 'user'); setStatus('loading'); }} />
+          </View>
+        </View>
+        <View style={{ position: 'absolute', bottom: 32, left: 16, right: 16, gap: 8 }}>
+          <View style={{ backgroundColor: 'rgba(42,22,32,0.7)', borderRadius: 16, padding: 12 }}>
+            <T size="sm" color="#fff">{mode === 'form' ? FORM_EXERCISES.find((e) => e.id === formEx)!.view : 'Side view, whole body in frame, phone steady (lean it on something).'}</T>
+          </View>
+          {recording ? <Button kind="light" title="Stop and analyse" icon="stop" onPress={stop} />
+            : <Button kind="light" title="Start recording the set" icon="radio-button-on" disabled={status !== 'ready'} onPress={() => { frames.current = []; setStatus('recording'); }} />}
+        </View>
+      </View>
+    );
+  }
+
+  // ── setup and results ──
+  return (
+    <Screen>
+      <View style={[s.row, { justifyContent: 'space-between' }]}>
+        <View style={{ flex: 1, gap: 2 }}>
+          <T size="micro">Optional</T>
+          <T size="xl">Camera tools</T>
+        </View>
+        <IconButton icon="close" label="Close" onPress={onClose} />
+      </View>
+      {error ? <Banner tone="danger" text={error} action={error === ERRORS.camera_denied && Platform.OS !== 'web' ? 'Settings' : undefined} onAction={() => Linking.openSettings()} /> : null}
+
+      {stage === 'result' && form ? <FormReport r={form} /> : null}
+      {stage === 'result' && speed ? (
+        <SpeedReport r={speed} attached={attached} onAttach={onVelocity && speed.ok ? () => { onVelocity(speed.mean); setAttached(true); track('bar_speed_attached'); } : undefined} />
+      ) : null}
+      {stage === 'result' ? <Button kind="primary" title="Try again" icon="refresh" onPress={() => { setAttached(false); openCamera(); }} /> : null}
+
+      {stage === 'setup' ? (<>
+        <Segmented value={mode} onChange={setMode} options={[{ value: 'form', label: 'Technique check' }, { value: 'speed', label: 'Bar speed' }]} />
+        {mode === 'form' ? (<>
+          <T muted>Describes your positions rep by rep, with how confident the estimate is. It never says a lift is safe or unsafe.</T>
+          <Choice value={formEx} onChange={setFormEx} options={FORM_EXERCISES.map((e) => ({ value: e.id, label: e.name, hint: e.view }))} />
+        </>) : (<>
+          <View style={[s.row, { justifyContent: 'space-between' }]}>
+            <T muted style={{ flex: 1 }}>Estimates how fast each rep moved on the way up, from your body position. Use it to compare sets, not as an exact number.</T>
+            <Why e={{ text: 'Bar speed slows as a set gets harder, and validated phone apps can measure it well. RepProof\'s estimate is simpler and not validated, so it always shows an uncertainty range and never changes your training by itself.', label: 'principle', refIds: ['monitoring_review', 'velocity_app', 'velocity_ai_app'] }} />
+          </View>
+          <Choice value={speedEx} onChange={setSpeedEx} options={SPEED_EXERCISES.map((e) => ({ value: e.id, label: e.name, hint: `Tracks your ${e.tracks}` }))} />
+          <Field label="Your height (cm), used to calibrate" keyboardType="number-pad" value={height} onChangeText={setHeight}
+            error={Number(height) >= 100 && Number(height) <= 250 ? undefined : 'Enter your height between 100 and 250 cm'} />
+        </>)}
+        <Button kind="primary" title="Open camera" icon="camera-outline" disabled={mode === 'speed' && !(Number(height) >= 100 && Number(height) <= 250)} onPress={openCamera} />
+      </>) : null}
+      <Button kind="ghost" title={stage === 'result' ? 'Done' : 'Cancel'} onPress={onClose} />
+    </Screen>
+  );
+}
+
+function FormReport({ r }: { r: FormResult }) {
+  if (!r.ok) {
+    return (
+      <Card>
+        <View style={s.row}><Ionicons name="alert-circle-outline" size={20} color={C.warn} /><T bold>No result this time</T></View>
+        <T>{r.text}</T>
+        <T muted size="sm">The check stops instead of guessing when it cannot see clearly.</T>
+      </Card>
+    );
+  }
+  return (<>
+    <Card variant="tint">
+      <View style={[s.row, { justifyContent: 'space-between' }]}>
+        <T size="micro">{FORM_EXERCISES.find((e) => e.id === r.exercise)!.name} · {r.reps} reps</T>
+        <Badge label="rule" />
+      </View>
+      <T muted size="sm">What the camera saw. Confidence is never rated high: this check is not validated.</T>
+    </Card>
+    {r.observations.map((o) => (
+      <Card key={o.title} flat>
+        <View style={[s.row, { justifyContent: 'space-between' }]}>
+          <T bold style={{ flex: 1 }}>{o.title}</T>
+          <Chip tone={o.confidence === 'moderate' ? 'principle' : 'warn'} label={`${o.confidence === 'moderate' ? 'Moderate' : 'Low'} confidence`} />
+        </View>
+        <T>{o.detail}</T>
+      </Card>
+    ))}
+    <Card flat>
+      <T size="micro">Limits</T>
+      {r.limits.map((l) => <T key={l} muted size="sm">• {l}</T>)}
+    </Card>
+  </>);
+}
+
+function SpeedReport({ r, onAttach, attached }: { r: SpeedResult; onAttach?: () => void; attached: boolean }) {
+  if (!r.ok) {
+    return (
+      <Card>
+        <View style={s.row}><Ionicons name="alert-circle-outline" size={20} color={C.warn} /><T bold>No estimate this time</T></View>
+        <T>{r.text}</T>
+      </Card>
+    );
+  }
+  return (<>
+    <Card variant="tint">
+      <T size="micro">Estimated lifting speed</T>
+      <T size="xl">~{r.mean} m/s <T muted size="sm">average of {r.reps.length} reps</T></T>
+      <T muted size="sm">Each value ±{r.uncertainty}% or more{r.loss !== null ? ` · slowed about ${r.loss}% from the fastest rep to the last` : ''}</T>
+    </Card>
+    <Card flat style={{ gap: 6 }}>
+      {r.reps.map((x) => (
+        <View key={x.rep} style={[s.row, { justifyContent: 'space-between' }]}>
+          <T>Rep {x.rep}</T>
+          <T bold>{x.mps} m/s <T muted size="sm">({x.low}–{x.high})</T></T>
+        </View>
+      ))}
+    </Card>
+    <Card flat>
+      <T size="micro">Limits</T>
+      {r.notes.map((n) => <T key={n} muted size="sm">• {n}</T>)}
+    </Card>
+    {onAttach ? (attached ? <Banner tone="accent" text="Attached to the set. It is stored as an estimate and does not change your plan." />
+      : <Button title={`Attach ~${r.mean} m/s to my last logged set`} onPress={onAttach} />) : null}
+  </>);
+}
