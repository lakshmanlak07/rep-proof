+// Android/iOS: the pose page in a WebView. Camera permission is asked by the caller first (expo-camera).
+import { useEffect, useRef } from 'react';
+import { WebView } from 'react-native-webview';
+
+import { POSE_HTML, type PoseMsg } from './poseHtml';
+
+export function PoseCamera({ facing, recording, onMessage }: { facing: 'user' | 'environment'; recording: boolean; onMessage: (m: PoseMsg) => void }) {
+  const ref = useRef<WebView>(null);
+  const run = (js: string) => ref.current?.injectJavaScript(`${js};true;`);
+  useEffect(() => { run(`window.cmd && window.cmd('${recording ? 'record' : 'pause'}')`); }, [recording]);
+  useEffect(() => () => { run(`window.cmd && window.cmd('close')`); }, []);
+  return (
+    <WebView
+      ref={ref}
+      // https base URL: getUserMedia only works in a secure context.
+      source={{ html: POSE_HTML, baseUrl: 'https://localhost/' }}
+      originWhitelist={['*']}
+      javaScriptEnabled
+      mediaPlaybackRequiresUserAction={false}
+      allowsInlineMediaPlayback
+      mediaCapturePermissionGrantType="grant"
+      style={{ flex: 1, backgroundColor: '#2A1620' }}
+      onMessage={(e) => {
+        let m: PoseMsg;
+        try { m = JSON.parse(e.nativeEvent.data); } catch { return; }
+        if (m.type === 'loaded') run(`window.cmd('start', '${facing}')`);
+        onMessage(m);
+      }}
+    />
+  );
+}
