@@ -0,0 +1,310 @@
+// Camera tools: technique observations and bar-speed estimates from body landmarks.
+// Pure functions over landmark frames (no camera, no React): the camera screen feeds frames from an
+// on-device pose model and shows what these return. Everything here is a RepProof rule built on simple
+// geometry. It is NOT a validated method, so confidence is never reported as high, and the analysis
+// refuses to guess when the view is poor (dark, blocked, more than one person, unsupported movement).
+
+/** Landmarks sent by the camera page, in this order (MediaPipe pose indices 0, 11-16, 23-28). */
+export const KEYS = ['nose', 'ls', 'rs', 'le', 're', 'lw', 'rw', 'lh', 'rh', 'lk', 'rk', 'la', 'ra'] as const;
+export type Key = (typeof KEYS)[number];
+export type Point = { x: number; y: number; v: number }; // normalised 0-1 (y grows downward), v = visibility 0-1
+/** One video frame: time in ms, people detected, landmarks of the most prominent person, mean brightness 0-255. */
+export type Frame = { t: number; people: number; lm: Record<Key, Point> | null; luma?: number };
+
+export type FormExercise = 'squat' | 'hinge' | 'push_up';
+export type SpeedExercise = 'squat' | 'bench' | 'deadlift' | 'press';
+export type Confidence = 'low' | 'moderate'; // never "high": the method is not validated
+export type StopReason = 'too_short' | 'no_person' | 'multiple_people' | 'too_dark' | 'not_visible' | 'no_reps' | 'unsupported';
+
+export const FORM_EXERCISES: { id: FormExercise; name: string; view: string }[] = [
+  { id: 'squat', name: 'Squat (any bar or bodyweight)', view: 'Side view, whole body in frame, phone at hip height' },
+  { id: 'hinge', name: 'Hinge (deadlift, Romanian deadlift)', view: 'Side view, whole body in frame' },
+  { id: 'push_up', name: 'Push-up', view: 'Side view, head to feet in frame, phone at floor level' },
+];
+export const SPEED_EXERCISES: { id: SpeedExercise; name: string; tracks: string }[] = [
+  { id: 'squat', name: 'Squat', tracks: 'shoulders (the bar sits on them)' },
+  { id: 'bench', name: 'Bench press', tracks: 'wrists (the bar is in your hands)' },
+  { id: 'deadlift', name: 'Deadlift', tracks: 'wrists (the bar is in your hands)' },
+  { id: 'press', name: 'Overhead press', tracks: 'wrists (the bar is in your hands)' },
+];
+
+export const STOP_TEXT: Record<StopReason, string> = {
+  too_short: 'The recording was too short. Record the whole set, at least 2 reps.',
+  no_person: 'No person was detected in most of the video. Step back so your whole body is in frame.',
+  multiple_people: 'More than one person was in view. The check only works with one person in frame, so nothing was analysed.',
+  too_dark: 'The video was too dark to track joints reliably. Add light or move the phone, then try again.',
+  not_visible: 'Key joints were hidden or out of frame for much of the set. Film side-on with your whole body visible.',
+  no_reps: 'No clear reps were found. Film side-on and make sure each rep goes through its full movement.',
+  unsupported: 'This did not look like a movement the check supports. It only analyses the exercises listed.',
+};
+
+// ───────────── geometry ─────────────
+type P = { x: number; y: number };
+const dist = (a: P, b: P) => Math.hypot(a.x - b.x, a.y - b.y);
+/** Angle at b (degrees) formed by a-b-c. */
+export function angle(a: P, b: P, c: P): number {
+  const v1 = { x: a.x - b.x, y: a.y - b.y };
+  const v2 = { x: c.x - b.x, y: c.y - b.y };
+  const cos = (v1.x * v2.x + v1.y * v2.y) / ((Math.hypot(v1.x, v1.y) * Math.hypot(v2.x, v2.y)) || 1);
+  return (Math.acos(Math.max(-1, Math.min(1, cos))) * 180) / Math.PI;
+}
+/** Lean of the a->b segment from vertical, degrees (0 = upright, 90 = horizontal). */
+const fromVertical = (a: P, b: P) => (Math.atan2(Math.abs(b.x - a.x), Math.abs(b.y - a.y)) * 180) / Math.PI;
+const mean = (xs: number[]) => (xs.length ? xs.reduce((a, b) => a + b, 0) / xs.length : 0);
+const median = (xs: number[]) => { const s = [...xs].sort((a, b) => a - b); return s.length ? s[Math.floor(s.length / 2)] : 0; };
+const sd = (xs: number[]) => { const m = mean(xs); return Math.sqrt(mean(xs.map((x) => (x - m) ** 2))); };
+const round = (x: number, d = 0) => Math.round(x * 10 ** d) / 10 ** d;
+
+/** The side of the body facing the camera: whichever has the more visible joints. */
+type Side = { s: Point; e: Point; w: Point; h: Point; k: Point; a: Point };
+function side(lm: Record<Key, Point>, pick: 'l' | 'r'): Side {
+  const g = (k: string) => lm[(pick + k) as Key];
+  return { s: g('s'), e: g('e'), w: g('w'), h: g('h'), k: g('k'), a: g('a') };
+}
+function pickSide(frames: Frame[]): 'l' | 'r' {
+  let l = 0, r = 0;
+  for (const f of frames) {
+    if (!f.lm) continue;
+    l += f.lm.ls.v + f.lm.lh.v + f.lm.lk.v + f.lm.la.v + f.lm.le.v + f.lm.lw.v;
+    r += f.lm.rs.v + f.lm.rh.v + f.lm.rk.v + f.lm.ra.v + f.lm.re.v + f.lm.rw.v;
+  }
+  return l >= r ? 'l' : 'r';
+}
+
+/** Moving average, window w (odd). */
+export function smooth(xs: number[], w = 5): number[] {
+  const h = Math.floor(w / 2);
+  return xs.map((_, i) => mean(xs.slice(Math.max(0, i - h), i + h + 1)));
+}
+
+/**
+ * Reps from a position signal where larger = lower in the image (y grows downward).
+ * A rep is top -> bottom -> top with a drop of at least `minDrop`. Returns frame indexes.
+ */
+export function segmentReps(y: number[], minDrop: number): { start: number; bottom: number; end: number }[] {
+  const reps: { start: number; bottom: number; end: number }[] = [];
+  let top = 0;
+  let bottom = -1;
+  for (let i = 1; i < y.length; i++) {
+    if (bottom < 0) {
+      if (y[i] < y[top]) top = i; // still finding the highest point before the descent
+      else if (y[i] - y[top] >= minDrop) bottom = i;
+    } else if (y[i] > y[bottom]) {
+      bottom = i; // still descending
+    } else if (y[bottom] - y[i] >= minDrop) {
+      // climbing back: the rep ends at the next local top
+      let end = i;
+      while (end + 1 < y.length && y[end + 1] <= y[end]) end++;
+      reps.push({ start: top, bottom, end });
+      top = end;
+      bottom = -1;
+      i = end;
+    }
+  }
+  return reps;
+}
+
+// ───────────── quality gates (shared) ─────────────
+export type Gate = { ok: true; frames: Frame[]; fps: number; visibility: number } | { ok: false; reason: StopReason };
+
+const REQUIRED: Record<FormExercise | SpeedExercise, ('s' | 'e' | 'w' | 'h' | 'k' | 'a')[]> = {
+  squat: ['s', 'h', 'k', 'a'], hinge: ['s', 'h', 'k', 'a'], push_up: ['s', 'e', 'w', 'h', 'a'],
+  bench: ['s', 'e', 'w', 'h'], deadlift: ['s', 'w', 'h', 'k'], press: ['s', 'e', 'w', 'h'],
+};
+
+export function gate(frames: Frame[], exercise: FormExercise | SpeedExercise): Gate {
+  if (frames.length < 20 || frames[frames.length - 1].t - frames[0].t < 2000) return { ok: false, reason: 'too_short' };
+  const multi = frames.filter((f) => f.people >= 2).length / frames.length;
+  if (multi > 0.15) return { ok: false, reason: 'multiple_people' };
+  const lit = frames.filter((f) => f.luma !== undefined).map((f) => f.luma!);
+  if (lit.length && median(lit) < 45) return { ok: false, reason: 'too_dark' };
+  const seen = frames.filter((f) => f.lm && f.people >= 1);
+  if (seen.length / frames.length < 0.6) return { ok: false, reason: 'no_person' };
+  const sd2 = pickSide(seen);
+  const vis = mean(seen.map((f) => mean(REQUIRED[exercise].map((k) => side(f.lm!, sd2)[k].v))));
+  if (vis < 0.5) return { ok: false, reason: 'not_visible' };
+  const fps = (seen.length - 1) / ((seen[seen.length - 1].t - seen[0].t) / 1000);
+  return { ok: true, frames: seen, fps, visibility: vis };
+}
+
+// ───────────── form check ─────────────
+export type Observation = { title: string; detail: string; confidence: Confidence };
+export type FormResult =
+  | { ok: false; reason: StopReason; text: string; detected?: FormExercise | null }
+  | { ok: true; exercise: FormExercise; reps: number; observations: Observation[]; limits: string[] };
+
+/** Which supported movement the landmarks look like, or null. */
+export function classify(frames: Frame[]): FormExercise | null {
+  const seen = frames.filter((f) => f.lm);
+  if (seen.length < 10) return null;
+  const sd2 = pickSide(seen);
+  const S = seen.map((f) => side(f.lm!, sd2));
+  const torso = median(S.map((p) => fromVertical(p.h, p.s)));
+  const knee = S.map((p) => angle(p.h, p.k, p.a));
+  const hip = S.map((p) => angle(p.s, p.h, p.k));
+  const elbow = S.map((p) => angle(p.s, p.e, p.w));
+  const range = (xs: number[]) => Math.max(...xs) - Math.min(...xs);
+  if (torso > 55 && range(elbow) > 45) return 'push_up';
+  if (range(knee) > 50) return 'squat';
+  if (range(hip) > 40 && range(knee) < 50) return 'hinge';
+  return null;
+}
+
+const conf = (vis: number, reps: number, sideOn: boolean): Confidence => (vis >= 0.75 && reps >= 3 && sideOn ? 'moderate' : 'low');
+
+export function analyseForm(frames: Frame[], exercise: FormExercise): FormResult {
+  const g = gate(frames, exercise);
+  if (!g.ok) return { ok: false, reason: g.reason, text: STOP_TEXT[g.reason] };
+  const detected = classify(g.frames);
+  if (detected !== exercise) {
+    const text = detected
+      ? `This looked more like a ${FORM_EXERCISES.find((e) => e.id === detected)!.name.toLowerCase()} than the exercise you chose. Choose the right one, or film side-on and try again.`
+      : STOP_TEXT.unsupported;
+    return { ok: false, reason: 'unsupported', text, detected };
+  }
+  const sd2 = pickSide(g.frames);
+  const S = g.frames.map((f) => side(f.lm!, sd2));
+  const T = g.frames.map((f) => f.t);
+  const torsoLen = median(S.map((p) => dist(p.s, p.h))) || 0.2;
+  // Side-on check: in a front view both shoulders are far apart horizontally.
+  const shoulderGap = median(g.frames.map((f) => Math.abs(f.lm!.ls.x - f.lm!.rs.x)));
+  const sideOn = shoulderGap < torsoLen * 0.45;
+  const signal = smooth(S.map((p) => (exercise === 'squat' ? p.h.y : p.s.y)));
+  const reps = segmentReps(signal, torsoLen * (exercise === 'push_up' ? 0.15 : 0.25));
+  if (!reps.length) return { ok: false, reason: 'no_reps', text: STOP_TEXT.no_reps };
+  const c = conf(g.visibility, reps.length, sideOn);
+  const obs: Observation[] = [];
+  const n = reps.length;
+
+  if (exercise === 'squat') {
+    const thigh = median(S.map((p) => dist(p.h, p.k))) || 0.2;
+    // Depth at the bottom: hip height relative to knee height, in thigh lengths (+ = hip below knee).
+    const depth = reps.map((r) => (S[r.bottom].h.y - S[r.bottom].k.y) / thigh);
+    const deep = depth.filter((d) => d >= -0.05).length;
+    obs.push({
+      title: 'Depth',
+      detail: deep === n ? `Your hips reached about knee height or lower on all ${n} reps.`
+        : deep === 0 ? `Your hips stayed above knee height on all ${n} reps. Depth is your choice; this is what the camera saw.`
+        : `Your hips reached about knee height or lower on ${deep} of ${n} reps.`,
+      confidence: c,
+    });
+    const lean = reps.map((r) => fromVertical(S[r.bottom].h, S[r.bottom].s));
+    obs.push({
+      title: 'Torso angle at the bottom',
+      detail: `About ${round(median(lean))}° from vertical. Lean depends on bar position, limb lengths and stance, so there is no single right number.`,
+      confidence: c,
+    });
+    if (n >= 3 && sd(depth) > 0.15) {
+      const worst = depth.indexOf(Math.min(...depth)) + 1;
+      obs.push({ title: 'Consistency', detail: `Depth varied between reps; rep ${worst} was the shallowest.`, confidence: c });
+    } else if (n >= 3) {
+      obs.push({ title: 'Consistency', detail: 'Depth looked similar from rep to rep.', confidence: c });
+    }
+  }
+
+  if (exercise === 'hinge') {
+    const lockout = reps.filter((r) => angle(S[r.end].s, S[r.end].h, S[r.end].k) >= 160).length;
+    obs.push({
+      title: 'Lockout',
+      detail: lockout === n ? `Your hips reached a standing position at the top of all ${n} reps.` : `Your hips reached a standing position at the top on ${lockout} of ${n} reps.`,
+      confidence: c,
+    });
+    const knee = reps.map((r) => 180 - angle(S[r.bottom].h, S[r.bottom].k, S[r.bottom].a));
+    obs.push({
+      title: 'Knee bend at the bottom',
+      detail: `About ${round(median(knee))}° of knee bend. Romanian deadlifts usually keep the knees softer than conventional deadlifts.`,
+      confidence: c,
+    });
+    const back = reps.map((r) => fromVertical(S[r.bottom].h, S[r.bottom].s));
+    obs.push({ title: 'Torso angle at the bottom', detail: `About ${round(median(back))}° from vertical.`, confidence: c });
+  }
+
+  if (exercise === 'push_up') {
+    const elbow = reps.map((r) => angle(S[r.bottom].s, S[r.bottom].e, S[r.bottom].w));
+    const deep = elbow.filter((a) => a <= 100).length;
+    obs.push({
+      title: 'Range of motion',
+      detail: deep === n ? `Your elbows bent to about 90° or more on all ${n} reps.` : `Your elbows bent to about 90° or more on ${deep} of ${n} reps.`,
+      confidence: c,
+    });
+    // Hip position against the shoulder-ankle line, in torso lengths (+ = hips below the line = sagging).
+    const sag = reps.map((r) => {
+      const p = S[r.bottom];
+      const k = (p.h.x - p.s.x) / ((p.a.x - p.s.x) || 1e-6);
+      return (p.h.y - (p.s.y + k * (p.a.y - p.s.y))) / torsoLen;
+    });
+    const off = sag.filter((x) => Math.abs(x) > 0.15).length;
+    obs.push({
+      title: 'Body line',
+      detail: off ? `Your hips were noticeably ${median(sag) > 0 ? 'below' : 'above'} the shoulder-to-ankle line on ${off} of ${n} reps.` : 'Your hips stayed roughly in line with your shoulders and ankles.',
+      confidence: c,
+    });
+  }
+
+  // Tempo, every exercise: lowering and lifting time per rep.
+  const down = reps.map((r) => (T[r.bottom] - T[r.start]) / 1000);
+  const up = reps.map((r) => (T[r.end] - T[r.bottom]) / 1000);
+  obs.push({ title: 'Tempo', detail: `About ${round(median(down), 1)} s down and ${round(median(up), 1)} s up per rep.`, confidence: c });
+
+  const limits = [
+    `Reps counted: ${n}. Check the count; a missed or extra rep means the observations are off too.`,
+    'Estimates from a single phone camera are rough. Camera angle, loose clothing and lighting change them.',
+    sideOn ? 'Filmed from the side, which suits these measurements.' : 'This did not look like a side view, so angles are less reliable.',
+    'This check describes positions. It cannot tell whether a lift is safe, whether you are injured, or what to do about pain.',
+  ];
+  return { ok: true, exercise, reps: n, observations: obs, limits };
+}
+
+// ───────────── bar speed ─────────────
+export type RepSpeed = { rep: number; mps: number; low: number; high: number };
+export type SpeedResult =
+  | { ok: false; reason: StopReason; text: string }
+  | { ok: true; reps: RepSpeed[]; mean: number; loss: number | null; uncertainty: number; notes: string[] };
+
+/** Shoulder-to-hip length as a share of standing height (adult segment proportions; varies by person). */
+const TORSO_SHARE = 0.288;
+const CALIBRATION_ERROR = 0.1; // person-to-person variation in that share
+const FLOOR_ERROR = 0.15; // never claim better than +/-15%: the method is not validated
+
+/**
+ * Mean concentric (lifting-phase) velocity per rep, in m/s, from the tracked body point.
+ * Scale comes from the lifter's height via torso length. Frame size (w, h in px) converts the
+ * normalised coordinates so x and y share one scale.
+ */
+export function estimateSpeed(frames: Frame[], exercise: SpeedExercise, heightCm: number, size: { w: number; h: number }): SpeedResult {
+  const g = gate(frames, exercise);
+  if (!g.ok) return { ok: false, reason: g.reason, text: STOP_TEXT[g.reason] };
+  if (!(heightCm >= 100 && heightCm <= 250)) return { ok: false, reason: 'unsupported', text: 'Set your height (100-250 cm) to calibrate the estimate.' };
+  const sd2 = pickSide(g.frames);
+  const S = g.frames.map((f) => side(f.lm!, sd2));
+  const T = g.frames.map((f) => f.t);
+  const px = (p: P) => ({ x: p.x * size.w, y: p.y * size.h });
+  const torsoPx = Math.max(...S.map((p) => dist(px(p.s), px(p.h)))); // longest = least foreshortened
+  const metresPerPx = (TORSO_SHARE * heightCm) / 100 / (torsoPx || 1);
+  const yPx = smooth(S.map((p) => px(exercise === 'squat' ? p.s : p.w).y), 3);
+  const reps = segmentReps(yPx, torsoPx * 0.2);
+  if (!reps.length) return { ok: false, reason: 'no_reps', text: STOP_TEXT.no_reps };
+
+  const jitter = sd(yPx.slice(0, 5)) || 1; // px noise while still at the start
+  const out: RepSpeed[] = reps.map((r, i) => {
+    const disp = (yPx[r.bottom] - yPx[r.end]) * metresPerPx; // lifting phase: bottom -> top
+    const secs = (T[r.end] - T[r.bottom]) / 1000;
+    const mps = secs > 0 ? disp / secs : 0;
+    const timing = (2 / g.fps) / (secs || 1);
+    const noise = jitter / Math.max(1, yPx[r.bottom] - yPx[r.end]);
+    const u = Math.max(FLOOR_ERROR, Math.sqrt(CALIBRATION_ERROR ** 2 + timing ** 2 + noise ** 2));
+    return { rep: i + 1, mps: round(mps, 2), low: round(mps * (1 - u), 2), high: round(mps * (1 + u), 2) };
+  }).filter((r) => r.mps > 0.05 && r.mps < 3);
+  if (!out.length) return { ok: false, reason: 'no_reps', text: STOP_TEXT.no_reps };
+  const u = Math.max(...out.map((r) => (r.high - r.mps) / (r.mps || 1)));
+  const loss = out.length >= 2 ? round((1 - out[out.length - 1].mps / Math.max(...out.map((r) => r.mps))) * 100) : null;
+  return {
+    ok: true, reps: out, mean: round(mean(out.map((r) => r.mps)), 2), loss, uncertainty: round(u * 100),
+    notes: [
+      `Tracks your ${SPEED_EXERCISES.find((e) => e.id === exercise)!.tracks}, not the bar itself.`,
+      `Calibrated from your height (${heightCm} cm). If that is off, every number is off by the same share.`,
+      `Each value could be about ${round(u * 100)}% higher or lower. Compare sets filmed the same way rather than reading single numbers.`,
+      'Not validated against a lab device. RepProof never changes your training from these readings unless you choose to.',
+    ],
+  };
+}
