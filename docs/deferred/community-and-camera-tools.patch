@@ -0,0 +1,156 @@
+// Community data access. Every rule (who can see, post, like, follow, report or moderate) is enforced by
+// row-level security and triggers in migration 6; this file only shapes the queries.
+import { must, ok } from './data';
+import { supabase } from './supabase';
+import type { ReportReason } from './communityRules';
+
+export type MemberProfile = { user_id: string; handle: string; display_name: string; bio: string | null; show_stats: boolean; banned_until: string | null };
+export type Post = {
+  id: string; user_id: string; body: string; topic: string; status: 'visible' | 'held' | 'removed'; held_reason: string | null;
+  like_count: number; comment_count: number; created_at: string; edited_at: string | null;
+  author: { handle: string; display_name: string } | null;
+};
+export type Comment = { id: string; post_id: string; user_id: string; body: string; status: Post['status']; held_reason: string | null; created_at: string; author: { handle: string; display_name: string } | null };
+
+const POST = 'id, user_id, body, topic, status, held_reason, like_count, comment_count, created_at, edited_at, author:community_profiles(handle, display_name)';
+const COMMENT = 'id, post_id, user_id, body, status, held_reason, created_at, author:community_profiles(handle, display_name)';
+
+export const TOPICS = [
+  { value: 'general', label: 'General' }, { value: 'training', label: 'Training' }, { value: 'nutrition', label: 'Nutrition' },
+  { value: 'progress', label: 'Progress' }, { value: 'question', label: 'Question' },
+] as const;
+
+/** Distinguishes "migration 6 not applied yet" from other failures, so screens can say so plainly. */
+export const notReady = (e: unknown) => ['42P01', 'PGRST205', 'PGRST202'].includes((e as { code?: string })?.code ?? '');
+
+export async function myProfile(userId: string): Promise<MemberProfile | null> {
+  const { data, error } = await supabase.from('community_profiles').select('user_id, handle, display_name, bio, show_stats, banned_until').eq('user_id', userId).maybeSingle();
+  if (error) throw error;
+  return data as MemberProfile | null;
+}
+
+export async function saveProfile(userId: string, p: { handle: string; display_name: string; bio: string | null; show_stats: boolean }, exists: boolean) {
+  if (exists) ok(await supabase.from('community_profiles').update(p).eq('user_id', userId));
+  else ok(await supabase.from('community_profiles').insert(p));
+}
+
+/** Leaving deletes the community profile and, by cascade, every post, comment, like and follow. */
+export async function leaveCommunity(userId: string) {
+  ok(await supabase.from('community_profiles').delete().eq('user_id', userId));
+}
+
+export async function feed(opts: { following?: string[]; topic?: string; before?: string; author?: string } = {}): Promise<Post[]> {
+  let q = supabase.from('posts').select(POST).order('created_at', { ascending: false }).limit(30);
+  if (opts.author) q = q.eq('user_id', opts.author);
+  else q = q.eq('status', 'visible');
+  if (opts.following) q = q.in('user_id', opts.following.length ? opts.following : ['00000000-0000-0000-0000-000000000000']);
+  if (opts.topic && opts.topic !== 'all') q = q.eq('topic', opts.topic);
+  if (opts.before) q = q.lt('created_at', opts.before);
+  return must(await q) as unknown as Post[];
+}
+
+export async function myHeldPosts(userId: string): Promise<Post[]> {
+  return must(await supabase.from('posts').select(POST).eq('user_id', userId).neq('status', 'visible').order('created_at', { ascending: false }).limit(20)) as unknown as Post[];
+}
+
+export async function post(id: string): Promise<Post | null> {
+  const { data, error } = await supabase.from('posts').select(POST).eq('id', id).maybeSingle();
+  if (error) throw error;
+  return data as unknown as Post | null;
+}
+
+export async function comments(postId: string): Promise<Comment[]> {
+  return must(await supabase.from('comments').select(COMMENT).eq('post_id', postId).order('created_at').limit(200)) as unknown as Comment[];
+}
+
+export async function createPost(body: string, topic: string): Promise<Post> {
+  return must(await supabase.from('posts').insert({ body: body.trim(), topic }).select(POST).single()) as unknown as Post;
+}
+export async function editPost(id: string, body: string) { ok(await supabase.from('posts').update({ body: body.trim() }).eq('id', id)); }
+export async function deletePost(id: string) { ok(await supabase.from('posts').delete().eq('id', id)); }
+export async function addComment(postId: string, body: string) { ok(await supabase.from('comments').insert({ post_id: postId, body: body.trim() })); }
+export async function deleteComment(id: string) { ok(await supabase.from('comments').delete().eq('id', id)); }
+
+export async function myLikes(postIds: string[]): Promise<Set<string>> {
+  if (!postIds.length) return new Set();
+  const rows = must(await supabase.from('post_likes').select('post_id').in('post_id', postIds));
+  return new Set(rows.map((r) => r.post_id as string));
+}
+export async function like(postId: string, on: boolean) {
+  if (on) ok(await supabase.from('post_likes').insert({ post_id: postId }));
+  else ok(await supabase.from('post_likes').delete().eq('post_id', postId));
+}
+
+/** Members I follow and members who follow me (follow lists are private to the two people involved). */
+export async function follows(userId: string): Promise<{ following: string[]; followers: string[] }> {
+  const rows = must(await supabase.from('follows').select('follower_id, followee_id'));
+  return {
+    following: rows.filter((r) => r.follower_id === userId).map((r) => r.followee_id as string),
+    followers: rows.filter((r) => r.followee_id === userId).map((r) => r.follower_id as string),
+  };
+}
+export async function follow(memberId: string, on: boolean) {
+  if (on) ok(await supabase.from('follows').insert({ followee_id: memberId }));
+  else ok(await supabase.from('follows').delete().eq('followee_id', memberId));
+}
+
+export async function blocked(): Promise<{ blocked_id: string }[]> {
+  return must(await supabase.from('blocks').select('blocked_id')) as { blocked_id: string }[];
+}
+export async function block(memberId: string, on: boolean) {
+  if (on) ok(await supabase.from('blocks').insert({ blocked_id: memberId }));
+  else ok(await supabase.from('blocks').delete().eq('blocked_id', memberId));
+}
+
+export async function report(target: { post_id?: string; comment_id?: string; reported_user?: string }, reason: ReportReason, details: string) {
+  const { error } = await supabase.from('reports').insert({ ...target, reason, details: details.trim() || null });
+  if (error && error.code !== '23505') throw error; // already reported: fine
+}
+
+export async function member(userId: string): Promise<MemberProfile | null> {
+  const { data, error } = await supabase.from('community_profiles').select('user_id, handle, display_name, bio, show_stats, banned_until').eq('user_id', userId).maybeSingle();
+  if (error) throw error;
+  return data as MemberProfile | null;
+}
+
+export async function memberStats(userId: string): Promise<{ workouts_30d: number; last_workout: string | null } | null> {
+  const { data, error } = await supabase.rpc('community_stats', { p_user: userId });
+  if (error) throw error;
+  return (data as { workouts_30d: number; last_workout: string | null }[])[0] ?? null;
+}
+
+// ───────────── moderation (server checks the caller is a moderator) ─────────────
+export async function isModerator(): Promise<boolean> {
+  const { data, error } = await supabase.rpc('is_moderator');
+  if (error) return false;
+  return !!data;
+}
+
+export type QueueReport = {
+  id: string; reason: string; details: string | null; status: string; created_at: string;
+  post_id: string | null; comment_id: string | null; reported_user: string | null;
+  post: { body: string; status: string; user_id: string } | null;
+  comment: { body: string; status: string; user_id: string } | null;
+};
+
+export async function openReports(): Promise<QueueReport[]> {
+  return must(await supabase.from('reports')
+    .select('id, reason, details, status, created_at, post_id, comment_id, reported_user, post:posts(body, status, user_id), comment:comments(body, status, user_id)')
+    .eq('status', 'open').order('created_at').limit(100)) as unknown as QueueReport[];
+}
+export async function heldContent(): Promise<{ posts: Post[]; comments: Comment[] }> {
+  const [p, c] = await Promise.all([
+    supabase.from('posts').select(POST).eq('status', 'held').order('created_at').limit(100),
+    supabase.from('comments').select(COMMENT).eq('status', 'held').order('created_at').limit(100),
+  ]);
+  return { posts: must(p) as unknown as Post[], comments: must(c) as unknown as Comment[] };
+}
+export async function moderate(kind: 'post' | 'comment', id: string, status: Post['status'], note?: string) {
+  ok(await supabase.rpc('moderate', { p_kind: kind, p_id: id, p_status: status, p_note: note ?? null }));
+}
+export async function resolveReport(id: string, status: 'actioned' | 'dismissed') {
+  ok(await supabase.rpc('resolve_report', { p_report: id, p_status: status }));
+}
+export async function banMember(userId: string, days: number, removeContent: boolean, note?: string) {
+  ok(await supabase.rpc('ban_member', { p_user: userId, p_days: days, p_remove_content: removeContent, p_note: note ?? null }));
+}
