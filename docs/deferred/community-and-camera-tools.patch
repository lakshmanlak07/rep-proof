+import { useLocalSearchParams } from 'expo-router';
+
+import { CameraLab, type Mode } from '@/camera/CameraLab';
+import { useData } from '@/lib/data';
+import { leave } from '@/lib/nav';
+
+/** Camera tools from the Train tab (outside a workout, so nothing can be attached to a set). */
+export default function CameraScreen() {
+  const { mode } = useLocalSearchParams<{ mode?: Mode }>();
+  const { profile } = useData();
+  return <CameraLab mode={mode === 'speed' ? 'speed' : 'form'} heightCm={Number(profile?.height_cm) || 0} onClose={leave} />;
+}
